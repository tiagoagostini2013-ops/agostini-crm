# Token pessoal de API do monday.com (Avatar > Administração > API, ou avatar > Developers)
# NUNCA compartilhe esse token nem faça commit dele no git.
MONDAY_API_TOKEN=

# ID do board do CRM Agostini no monday.com (já vem preenchido com o board atual)
MONDAY_BOARD_ID=18404435549

# Opcional: versão da API do monday.com (formato AAAA-MM). Deixe em branco para usar a padrão da conta.
MONDAY_API_VERSION=

# Senha compartilhada para acessar a página (proteção simples contra acesso indevido pela internet).
APP_PASSWORD=troque-esta-senha

# Chave aleatória usada para assinar o cookie de sessão. Gere uma com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
