# Token pessoal de API do monday.com (Avatar > Administração > API, ou avatar > Developers)
# NUNCA compartilhe esse token nem faça commit dele no git.
MONDAY_API_TOKEN=

# ID do board do CRM Agostini no monday.com (já vem preenchido com o board atual)
MONDAY_BOARD_ID=18404435549

# Opcional: versão da API do monday.com (formato AAAA-MM). Deixe em branco para usar a padrão da conta.
MONDAY_API_VERSION=

# Senha compartilhada para acessar a página (proteção simples contra acesso indevido pela internet).
APP_PASSWORD=troque-esta-senha

# Chave aleatória usada para assinar o cookie de sessão. Gere uma com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Opcional — só necessário para o suplemento do Word converter automaticamente
# a proposta para PDF ao vincular ao CRM. Sem essa chave, o suplemento
# continua funcionando normalmente, só anexa o .docx (sem gerar o PDF sozinho).
# Crie uma conta grátis em https://cloudconvert.com (o plano free já cobre um
# volume folgado de propostas por mês) e gere a chave em Dashboard > API Keys.
CLOUDCONVERT_API_KEY=

# OBRIGATÓRIO para o suplemento do Word conseguir vincular propostas (botão
# "Vincular proposta ao CRM"). Funções da Vercel recusam receber mais de
# 4.5MB de uma vez, e uma proposta técnica com fotos/desenhos passa disso
# fácil — por isso o suplemento sobe o .docx direto pro Vercel Blob, e só
# depois nosso backend busca o arquivo de lá pra mandar ao monday.com.
# Não precisa colar valor aqui: na Vercel, vá em Storage > Create Database >
# Blob (é grátis) e conecte ao projeto — a variável é criada sozinha.
BLOB_READ_WRITE_TOKEN=
