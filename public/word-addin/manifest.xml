<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suplemento do Word — CRM Agostini.

  ANTES DE USAR: troque TODAS as ocorrências de agostini-crm.vercel.app abaixo pelo
  domínio real do painel publicado na Vercel (ex: agostini-crm.vercel.app),
  sem "https://" duplicado. Pode usar localizar-e-substituir num editor de
  texto simples (Bloco de Notas serve).

  Depois de ajustar, no Word: Inserir > Suplementos > Meus Suplementos >
  Carregar Meu Suplemento > selecione este arquivo. É um passo único por
  computador/vendedor (não existe deploy central sem plano Microsoft 365
  Business/Enterprise, mas funciona normalmente com contas pessoais).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>74b4d67a-a483-4585-9fa2-61a2264b0c96</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Agostini Industrial</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  <DisplayName DefaultValue="CRM Agostini" />
  <Description DefaultValue="Busca dados de clientes do CRM Agostini e vincula a proposta ao lead certo, direto do Word." />
  <IconUrl DefaultValue="https://agostini-crm.vercel.app/word-addin/icon-32.png" />
  <HighResIconUrl DefaultValue="https://agostini-crm.vercel.app/word-addin/icon-80.png" />
  <SupportUrl DefaultValue="https://agostini-crm.vercel.app" />

  <AppDomains>
    <AppDomain>https://agostini-crm.vercel.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://agostini-crm.vercel.app/word-addin" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CRMAgostini.Group1">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="CRMAgostini.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CRMAgostini.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://agostini-crm.vercel.app/word-addin/icon-32.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://agostini-crm.vercel.app/word-addin/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://agostini-crm.vercel.app/word-addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://agostini-crm.vercel.app/word-addin" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://agostini-crm.vercel.app/word-addin" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://agostini-crm.vercel.app" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="O suplemento CRM Agostini já está pronto!" />
        <bt:String id="CommandsGroup.Label" DefaultValue="CRM Agostini" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Abrir CRM" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Busque um cliente do CRM e vincule a proposta a ele direto pelo Word." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Buscar cliente no CRM Agostini e vincular esta proposta a ele." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
